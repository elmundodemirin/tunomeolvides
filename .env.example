# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-secreta

# URL pública del sitio (usada en emails de invitación/recuperación de contraseña)
# En desarrollo: http://localhost:3000
# En producción (Vercel): https://nomeolvides.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 (añadir cuando se tenga el dominio definitivo)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Resend: envía el aviso por email a info@tunomeolvides.es cuando llega un
# mensaje nuevo del formulario de contacto (app/api/contact/route.ts).
# Clave de tipo "Sending access" desde resend.com/api-keys.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
